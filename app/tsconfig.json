{
  "compilerOptions": {
    /* Plain ES modules, served straight to the webview / browser: no bundler,
       so emitted imports keep the `./foo.js` specifiers written in the source. */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "inlineSources": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
