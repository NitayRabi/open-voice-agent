{
  "identifier": "default",
  "description": "Capabilities for the bubble and settings windows",
  "windows": ["bubble", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:app:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:webview:default",
    "global-shortcut:default",
    "dialog:default",
    "opener:default"
  ]
}
